# Alternatif bila server KMH sudah memakai Nginx (tanpa Docker atau tanpa Caddy).
server {
  listen 443 ssl http2;
  server_name p2p.kmh.coop;
  ssl_certificate     /etc/letsencrypt/live/p2p.kmh.coop/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/p2p.kmh.coop/privkey.pem;
  client_max_body_size 6m;
  location / {
    proxy_pass http://127.0.0.1:3000;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
}
server { listen 80; server_name p2p.kmh.coop; return 301 https://$host$request_uri; }
