# ===== Wajib =====
# Koneksi PostgreSQL. Pada docker-compose sudah diisi otomatis.
DATABASE_URL=postgres://kmh:GANTI_PASSWORD_DB@db:5432/kmh
# Rahasia penandatangan sesi, minimal 32 karakter acak. Buat dengan: openssl rand -base64 48
JWT_SECRET=GANTI_DENGAN_RAHASIA_ACAK_MINIMAL_32_KARAKTER
# Admin pertama (dibuat sekali saat server pertama kali berjalan). Segera ganti kata sandi & aktifkan 2FA.
ADMIN_EMAIL=admin@kmh.coop
ADMIN_PASSWORD=GANTI_PASSWORD_ADMIN
ADMIN_NAME=Administrator KMH

# ===== Virtual Account =====
# Nama penyedia; webhook diterima di https://DOMAIN/api/webhooks/va/<VA_PROVIDER>
VA_PROVIDER=bank
# Rahasia HMAC-SHA256 yang disepakati dengan bank/payment gateway (header x-signature)
VA_WEBHOOK_SECRET=GANTI_DENGAN_RAHASIA_WEBHOOK

# ===== Keamanan =====
# true bila diakses lewat HTTPS (wajib di produksi)
COOKIE_SECURE=true
# SameSite cookie sesi: strict (satu domain) atau none (frontend & backend beda domain, wajib bersama COOKIE_SECURE=true)
COOKIE_SAMESITE=strict
# Daftar origin frontend yang diizinkan memanggil API (pisahkan dengan koma). Contoh: https://pendanaan.domain.co.id
ALLOWED_ORIGINS=
# Host yang diizinkan, dipisah koma (bisa juga pakai pola .domain.co.id)
ALLOWED_HOSTS=p2p.kmh.coop
# Wajibkan 2FA untuk staf back-office
REQUIRE_2FA_BACKOFFICE=true

# ===== Hanya untuk server uji (JANGAN aktifkan di produksi) =====
ALLOW_VA_SIMULATOR=false
ALLOW_TIME_TRAVEL=false

# ===== Lain-lain =====
PORT=3000
UPLOAD_DIR=/app/data/uploads
# Selisih zona waktu jam (WIB = 7)
TZ_OFFSET_HOURS=7
POSTGRES_PASSWORD=GANTI_PASSWORD_DB
DOMAIN=p2p.kmh.coop
# WebAuthn: kosongkan agar rpID diambil otomatis dari hostname request (disarankan di produksi)
WEBAUTHN_RP_ID=
WEBAUTHN_RP_NAME=KMH P2P
WEBAUTHN_ORIGIN=
